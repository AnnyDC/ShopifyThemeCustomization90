<section class="demo-width demo-band"><h1>{{ collection.title | escape }}</h1><div>{{ collection.description }}</div>
  <form method="get" action="{{ collection.url }}" class="demo-filters">
    {% for filter in collection.filters %}<details{% if filter.active_values != blank %} open{% endif %}><summary>{{ filter.label | escape }}</summary>
      {% case filter.type %}{% when 'list', 'boolean' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> {{ value.label | escape }} ({{ value.count }})</label>{% endfor %}
      {% when 'price_range' %}<label>{{ 'demo.minimum_price' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" step="any"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>{{ 'demo.maximum_price' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" step="any"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>{% endcase %}</details>{% endfor %}
    {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}<label for="DemoSort-{{ section.id }}">{{ 'products.facets.sort_by_label' | t }}</label><select id="DemoSort-{{ section.id }}" name="sort_by">{% for sort in collection.sort_options %}<option value="{{ sort.value | escape }}"{% if sort.value == sort_by %} selected{% endif %}>{{ sort.name | escape }}</option>{% endfor %}</select><button type="submit">{{ 'demo.apply' | t }}</button><a href="{{ collection.url }}">{{ 'products.facets.clear_all' | t }}</a>
  </form>
  {% paginate collection.products by section.settings.page_size %}<div class="demo-product-grid">{% for listed_product in collection.products %}{% assign eager = false %}{% if forloop.index <= 2 %}{% assign eager = true %}{% endif %}{% render 'demo-product-card', card_product: listed_product, eager: eager %}{% else %}<p>{{ 'sections.collection_template.empty' | t }}</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="demo-pagination" aria-label="{{ 'general.pagination.label' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}
</section>
{% schema %}{"name":"Demo collection","settings":[{"type":"range","id":"page_size","label":"Products per page","min":4,"max":24,"step":4,"default":12}]}{% endschema %}
