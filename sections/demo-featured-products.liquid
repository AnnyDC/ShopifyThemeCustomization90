<section class="demo-width demo-band" aria-labelledby="FeaturedHeading-{{ section.id }}">
  {% if template.name == 'index' %}<h1 id="FeaturedHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>{% else %}<h2 id="FeaturedHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
  {% assign featured_collection = section.settings.collection | default: collections.all %}
  <div class="demo-product-grid">{% for featured_product in featured_collection.products limit: section.settings.limit %}{% assign eager = false %}{% if forloop.index <= 2 %}{% assign eager = true %}{% endif %}{% render 'demo-product-card', card_product: featured_product, eager: eager %}{% else %}<p>{{ 'demo.no_products' | t }}</p>{% endfor %}</div>
  {% if featured_collection %}<a class="demo-text-link" href="{{ featured_collection.url }}">{{ 'demo.view_collection' | t }}</a>{% endif %}
</section>
{% schema %}{"name":"Demo featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Personalized gifts"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":2,"max":12,"step":1,"default":4,"label":"Product count"}],"presets":[{"name":"Demo featured products"}]}{% endschema %}
