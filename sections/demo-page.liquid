<article class="demo-width demo-band demo-content"><h1>{{ page.title | escape }}</h1>{{ page.content }}{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary>{{ block.settings.answer }}</details>{% endfor %}</article>
{% schema %}{"name":"Demo content page","settings":[],"blocks":[{"type":"question","name":"FAQ","settings":[{"type":"text","id":"question","label":"Question","default":"How do I care for my gift?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Follow the product care guide supplied with your item.</p>"}]}]}{% endschema %}
