{% assign selected_variant = product.selected_or_first_available_variant %}
<demo-product class="demo-width demo-band demo-product" data-section-id="{{ section.id }}">
  <div class="demo-product-media" data-product-media>{% assign primary_image = selected_variant.featured_image | default: product.featured_image %}{% if primary_image %}{{ primary_image | image_url: width: 1400 | image_tag: widths: '400,700,1000,1400', sizes: '(min-width: 800px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'demo-placeholder' }}{% endif %}</div>
  <div><h1>{{ product.title | escape }}</h1><div data-variant-price aria-live="polite"><span>{{ selected_variant.price | money }}</span> {% if selected_variant.compare_at_price > selected_variant.price %}<s>{{ selected_variant.compare_at_price | money }}</s>{% endif %}</div><div class="demo-description">{{ product.description }}</div>
    {% assign product_form_id = 'DemoProductForm-' | append: section.id %}
    {% form 'product', product, id: product_form_id, class: 'demo-product-form' %}
      <label for="DemoVariant-{{ section.id }}" data-variant-label>{{ 'demo.variant' | t }}</label><select name="id" id="DemoVariant-{{ section.id }}" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == selected_variant.id %} selected{% endif %}>{{ variant.title | escape }} - {{ variant.price | money | strip_html | escape }}{% unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>
      <div data-option-pickers hidden>{% for option in product.options_with_values %}<label for="DemoOption-{{ section.id }}-{{ forloop.index }}">{{ option.name | escape }}</label><select id="DemoOption-{{ section.id }}-{{ forloop.index }}" data-option-index="{{ forloop.index0 }}">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select>{% endfor %}</div>
      <label for="DemoQuantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label><input id="DemoQuantity-{{ section.id }}" name="quantity" type="number" min="{{ selected_variant.quantity_rule.min }}" step="{{ selected_variant.quantity_rule.increment }}" value="{{ selected_variant.quantity_rule.min }}"{% if selected_variant.quantity_rule.max %} max="{{ selected_variant.quantity_rule.max }}"{% endif %} required>
      {% if section.settings.enable_personalization %}<label for="DemoEngraving-{{ section.id }}">{{ 'demo.engraving' | t }}</label><input id="DemoEngraving-{{ section.id }}" name="properties[Engraving]" maxlength="{{ section.settings.engraving_limit }}" autocomplete="off"><label for="DemoGift-{{ section.id }}">{{ 'demo.gift_message' | t }}</label><textarea id="DemoGift-{{ section.id }}" name="properties[Gift message]" maxlength="200" rows="3"></textarea>{% endif %}
      <button type="submit" name="add"{% unless selected_variant.available %} disabled{% endunless %}>{% if selected_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button><p data-product-error role="alert"></p>
    {% endform %}
    {% render 'demo-product-details', detail_product: product, guide_fallback: section.settings.guide %}
  </div>
  {% capture variants_json %}[
    {% for variant in product.variants %}{"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | strip_html | json }},"compare":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},"image":{% assign variant_image = variant.featured_image | default: product.featured_image %}{% if variant_image %}{{ variant_image | image_url: width: 1400 | json }}{% else %}null{% endif %},"alt":{{ variant_image.alt | default: product.title | json }},"min":{{ variant.quantity_rule.min | json }},"step":{{ variant.quantity_rule.increment | json }},"max":{{ variant.quantity_rule.max | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}
  ]{% endcapture %}
  <script type="application/json" data-variants>{{ variants_json | replace: '<', '\u003c' }}</script>
</demo-product>
<script type="application/ld+json">{{ product | structured_data | replace: '<', '\u003c' }}</script>
{% schema %}{"name":"Personalized product","settings":[{"type":"checkbox","id":"enable_personalization","label":"Enable personalization","default":true},{"type":"range","id":"engraving_limit","label":"Engraving character limit","min":10,"max":100,"step":5,"default":40},{"type":"metaobject","id":"guide","metaobject_type":"care_guide","label":"Fallback care guide"}]}{% endschema %}
