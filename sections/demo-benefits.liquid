<section class="demo-benefits"><div class="demo-width demo-benefit-grid">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2><div>{{ block.settings.text }}</div></div>{% endfor %}</div></section>
{% schema %}{"name":"Demo benefits","max_blocks":4,"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"heading","label":"Heading","default":"Made for you"},{"type":"richtext","id":"text","label":"Text","default":"<p>Add a personal message to your gift.</p>"}]}],"presets":[{"name":"Demo benefits","blocks":[{"type":"benefit"},{"type":"benefit"}]}]}{% endschema %}
