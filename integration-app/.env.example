# Local simulation only. Replace local tokens before exposing an HTTPS tunnel.
MOCK_MODE=true
PORT=3001
SHOPIFY_SHOP=code-with-anny.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
MOCK_WEBHOOK_SECRET=local-demo-signature-only
INSPECTION_TOKEN=replace-with-a-random-local-token
CRM_TOKEN=replace-with-another-random-local-token
PUBLIC_URL=https://your-free-tunnel.example
DATABASE_PATH=./data/demo.sqlite
CRM_URL=http://127.0.0.1:3001/mock-crm/orders
# Optional: used only by scripts/verify-storefront.js for the password-protected preview.
STOREFRONT_PASSWORD=
